# Local development only. Copy to .env locally; never commit the real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PORT=8787
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173

# Only for testing the existing file:// front end locally. Do not enable in production.
ALLOW_FILE_ORIGIN=false

# Production defaults to secure cookies. Set false only for local HTTP testing.
WEB_COOKIE_SECURE=false

# Required for Phase 3F-2 NetEase credential encryption. Generate a random
# 32-byte value and store its Base64 form only in the deployment secret store.
NETEASE_CREDENTIAL_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_SECRET
